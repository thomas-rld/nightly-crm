# Port d'écoute du serveur HTTP (ignoré sur Vercel, défaut 3000 en local)
PORT=3000

# Adresse d'écoute du serveur (0.0.0.0 par défaut pour accepter les connexions externes)
HOST=0.0.0.0

# Clé d'API attendue dans le header "x-api-key" pour authentifier les appels
# entrants sur POST /webhook/agent.
# Sur Vercel : Project Settings → Environment Variables → API_KEY
# Si elle est absente, l'app démarre (SPA) mais le webhook répond 401.
API_KEY=change-me
